# check=skip=InvalidBaseImagePlatform
FROM quay.io/pypa/manylinux2014_x86_64

ARG JDK8_URL=https://api.adoptium.net/v3/binary/latest/8/ga/linux/x64/jdk/hotspot/normal/eclipse
ARG MAVEN_VERSION=3.9.9
ARG SPARK_VERSION=3.4.4
ARG RUST_TOOLCHAIN=stable

ENV JAVA_HOME=/opt/java/openjdk
ENV MAVEN_HOME=/opt/maven
ENV SPARK_HOME=/opt/spark
ENV CARGO_HOME=/usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup
ENV PATH=${MAVEN_HOME}/bin:${CARGO_HOME}/bin:${SPARK_HOME}/bin:${JAVA_HOME}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN set -eux; \
    mkdir -p "${JAVA_HOME}"; \
    curl -fsSL "${JDK8_URL}" -o /tmp/jdk8.tar.gz; \
    tar -xzf /tmp/jdk8.tar.gz -C "${JAVA_HOME}" --strip-components=1; \
    rm -f /tmp/jdk8.tar.gz

RUN set -eux; \
    mkdir -p "${MAVEN_HOME}"; \
    curl -fsSL "https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz" -o /tmp/maven.tgz; \
    tar -xzf /tmp/maven.tgz -C "${MAVEN_HOME}" --strip-components=1; \
    rm -f /tmp/maven.tgz

RUN set -eux; \
    curl -fsSL "https://archive.apache.org/dist/spark/spark-${SPARK_VERSION}/spark-${SPARK_VERSION}-bin-hadoop3.tgz" -o /tmp/spark.tgz; \
    tar -xzf /tmp/spark.tgz -C /opt; \
    mv "/opt/spark-${SPARK_VERSION}-bin-hadoop3" "${SPARK_HOME}"; \
    rm -f /tmp/spark.tgz

RUN set -eux; \
    curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain "${RUST_TOOLCHAIN}"; \
    chmod -R a+rX "${CARGO_HOME}" "${RUSTUP_HOME}"

RUN set -eux; \
    ldd --version | head -n 1; \
    java -version; \
    mvn -version; \
    rustc --version; \
    cargo --version; \
    spark-submit --version

WORKDIR /work/nativeio/paimon
